# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep example, ignore real secrets
.env
.env.local
.env.*.local
!.env.local.example

# SQLite database files (local only — data lives in Supabase for deployed version)
*.db
*.db-shm
*.db-wal

# Python cache
__pycache__/
*.pyc
*.pyo
ml/*.pkl

# Large dump files
*.html
postgres_seed.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
scrapers/redraft_update.log
scrapers/redraft/unmatched_nflverse.json
