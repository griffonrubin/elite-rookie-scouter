# Dynasty Scout — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─────────────────────────────────────────
# DATABASE (Required)
# ─────────────────────────────────────────

# Supabase PostgreSQL connection string
# Found in: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use the "Transaction" pooler URL (port 6543) for serverless/Vercel deployments
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ─────────────────────────────────────────
# SUPABASE (Optional — only if using Supabase client directly)
# ─────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
